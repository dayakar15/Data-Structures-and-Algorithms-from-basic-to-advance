numbers = [2,3,4,6,5,4,6,-87,0]
positive_number = 0
negative_number = 0
zero = 0
for num in numbers:
    if num > 0:
        positive_number += 1
    elif num < 0:
        negative_number += 1
    else:
        zero += 1
print("Positive Number:", positive_number)
print("Negative Number:", negative_number)
print("Zero:", zero)
        
