numbers = [ 1,2,3,4,5,6]
k = 2
window_sum = 0

for i in range(k):
    window_sum += numbers[i]
    
min_sum = window_sum
for i in range(k, len(numbers)):
    window_sum = window_sum - numbers[i - k] + numbers[i]
    if min_sum > window_sum:
        min_sum = window_sum
print("minimum sum:", min_sum)
