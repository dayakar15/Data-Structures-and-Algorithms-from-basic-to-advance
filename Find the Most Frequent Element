
numbers = [2, 3, 2, 5, 3, 2]
frequency = {}

for num in numbers:
    if num in frequency:
        frequency[num] += 1
    else:
        frequency[num] = 1

most_frequent = numbers[0]

for num in frequency:
    if frequency[num] > frequency[most_frequent]:
        most_frequent = num

print("Most frequent:", most_frequent)
print("Frequency:", frequency[most_frequent])
