numbers = [2, 6, 11, 15]
target = 9
found = False
for i in range(len(numbers)):
    for j in range(i + 1, len(numbers)):
        if numbers[i] + numbers[j] == target:
            print(numbers[i], "+", numbers[j], "=", target)
            found = True
    if found:
        break
if not found:
    print("pair not found")
