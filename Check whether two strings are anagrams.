text1 = "listen"
text2 = "silent"
if len(text1) != len(text2):
    print(False)
else:
    frequency = {}
    
    for ch in text1:
        if ch in frequency:
            frequency[ch] += 1
        else:
            frequency[ch] = 1
            
    for ch in text2:
        if ch in frequency:
            frequency[ch] -= 1
        else:
            frequency = 1
            
    is_anagram = True
    for count in frequency.values():
        if count!= 0:
            is_anagram  = False
            break
        
print(is_anagram)
